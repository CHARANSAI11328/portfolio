{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin-auth.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin-auth.html"
    }
  ]
}
